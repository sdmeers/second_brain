# Second Brain Environment Configuration Template
# Copy this file to backend/.env and populate with your personal settings

# Vault Path (Required)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
PORT=8080

# LLM & Embedding Providers (gemini | openai | ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Telegram Bot Configuration
ENABLE_TELEGRAM_BOT=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Gmail Ingestion Configuration (Optional)
ENABLE_GMAIL_POLLING=false
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Atlassian Jira Integration (Optional)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_DEFAULT_PROJECT_KEY=YOUR_PROJECT_KEY

# Ingestion Toggles & Tuning
ENABLE_OBSIDIAN_INBOX_POLLING=false
WIKILINK_SIMILARITY_THRESHOLD=1.2

# Embedding throughput. The Gemini embedding quota counts texts per minute per project
# (paid tier observed at 3,000). Lower these if you hit sustained 429s during re-indexing.
EMBEDDING_TEXTS_PER_MINUTE=2500
EMBEDDING_BATCH_SIZE=100

# Optional shared secret for the HTTP API (/process, /query).
# When set, callers must send `Authorization: Bearer <token>`.
# The Chrome extension reads the same value from extension/config.js.
# Leave blank to keep the API open (previous behaviour).
API_AUTH_TOKEN=
