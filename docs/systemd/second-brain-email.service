[Unit]
Description=Second Brain personal email digest (read-only)
After=network-online.target

[Service]
Type=oneshot
# EDIT THESE PATHS for your machine. Does nothing unless ENABLE_EMAIL_FEED=true.
WorkingDirectory=/home/username/second_brain
ExecStart=/home/username/second_brain/backend/.venv/bin/python3 -m backend.feeds.mail sync
