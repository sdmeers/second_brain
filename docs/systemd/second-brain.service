[Unit]
Description=Second Brain Orchestrator Daemon (GTD + PARA)
After=network.target

[Service]
Type=simple
# EDIT THESE THREE PATHS for your machine.
# WorkingDirectory is the backend/ directory; PYTHONPATH is the repository root, which
# is what lets `backend` resolve as a package from inside main.py.
WorkingDirectory=/home/username/second_brain/backend
ExecStart=/home/username/.local/bin/uv run main.py
Environment=PYTHONPATH=/home/username/second_brain
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
